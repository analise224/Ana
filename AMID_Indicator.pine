// © AMID SMC — Accumulation · Manipulation · IFVG · Distribution  (v5 — Final)
//@version=6
indicator("AMID SMC — Accumulation · Manipulation · IFVG · Distribution",
          shorttitle="AMID", overlay=true,
          max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// ─────────────────────────────────────────────────────────────────────────────
//  SETTINGS
// ─────────────────────────────────────────────────────────────────────────────
var G1 = "Accumulation"
acc_ratio   = input.float(0.80, "ATR Compression Ratio", minval=0.3, maxval=0.99, step=0.05, group=G1,
              tooltip="Fires when ATR(7) ÷ ATR(50) < this. Raise it (→0.90) if no yellow box appears.")
acc_minbars = input.int  (4,    "Min Bars in Zone",      minval=2,   group=G1)

var G2 = "Manipulation"
sw_atr       = input.float(0.2, "Sweep (× ATR)",              minval=0.05, step=0.05, group=G2)
manip_expiry = input.int  (80,  "Signal Window (bars)",        minval=5,    group=G2)
zone_expiry  = input.int  (60,  "Zone Auto-Expiry (bars)",     minval=5,    group=G2)

var G3 = "FVG / IFVG"
fvg_show_all = input.bool (false, "Show All FVGs (not just after manipulation)", group=G3,
              tooltip="OFF = only show FVGs that form after a manipulation sweep (cleaner). ON = show every FVG.")
fvg_max_show = input.int  (3,    "Max Visible FVGs",    minval=1, maxval=10, group=G3)
fvg_extend   = input.int  (40,   "Extend Unfilled (bars)",  minval=5,    group=G3)
fvg_max_age  = input.int  (100,  "Max Age (bars)",           minval=10,   group=G3)

var G4 = "Signals"
show_sig = input.bool (true, "Show Entry Signals", group=G4)
tp_mult  = input.float(2.0,  "TP (× ATR)",         minval=0.5, step=0.5, group=G4)
sl_mult  = input.float(1.0,  "SL (× ATR)",         minval=0.1, step=0.1, group=G4)

// ─────────────────────────────────────────────────────────────────────────────
//  PALETTE
// ─────────────────────────────────────────────────────────────────────────────
C_ACC_BG    = color.new(#FFF9C4, 60)   // pale yellow
C_ACC_BRD   = color.new(#F9A825,  0)   // amber
C_MANIP     = #F57C00                  // deep orange
C_BULL_FVG  = color.new(#26A69A, 88)   // teal (unfilled bull — very faint, not distracting)
C_BEAR_FVG  = color.new(#EF5350, 88)   // red  (unfilled bear — very faint)
C_BULL_IFVG = color.new(#00C853, 65)   // green (IFVG bull — visible but not overpowering)
C_BEAR_IFVG = color.new(#FF1744, 65)   // red   (IFVG bear — visible but not overpowering)
C_BULL_BRD  = color.new(#00C853, 20)
C_BEAR_BRD  = color.new(#FF1744, 20)
C_LONG      = #00C853
C_SHORT     = #FF1744

// ─────────────────────────────────────────────────────────────────────────────
//  UDT
// ─────────────────────────────────────────────────────────────────────────────
type FVG
    float top
    float bot
    int   dir     //  1 = bull gap,  -1 = bear gap
    int   born
    bool  filled
    bool  acted
    box   bx

// ─────────────────────────────────────────────────────────────────────────────
//  TIMEFRAME AUTO-SCALING
//  All bar-count settings are calibrated for 4H (240 min/bar).
//  We scale them proportionally so the indicator behaves identically on any TF.
//  Visual extensions (FVG width, line offset) are capped at 8× to avoid
//  drawing boxes thousands of bars wide on sub-minute charts.
// ─────────────────────────────────────────────────────────────────────────────
_tf_mins       = math.max(1.0, timeframe.in_seconds() / 60.0)
_tf_scale      = math.min(48.0, 240.0 / _tf_mins)          // logic scale (expiry, age)
_tf_vis        = math.min( 8.0, _tf_scale)                  // visual scale (extend, offsets)
manip_exp_adj  = math.max(5,  math.round(manip_expiry * _tf_scale))
zone_exp_adj   = math.max(5,  math.round(zone_expiry  * _tf_scale))
fvg_extend_adj = math.max(3,  math.round(fvg_extend   * _tf_vis))
fvg_age_adj    = math.max(10, math.round(fvg_max_age  * _tf_scale))
line_ext_adj   = math.max(5,  math.round(25           * _tf_vis))

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE 1 — ACCUMULATION  (ATR compression)
// ─────────────────────────────────────────────────────────────────────────────
atr      = ta.atr(14)
atr_fast = ta.atr(7)
atr_slow = ta.atr(50)

squeezed = atr_fast < atr_slow * acc_ratio

var float acc_hi   = na
var float acc_lo   = na
var int   acc_cnt  = 0
var bool  in_acc   = false
var int   acc_s    = 0
var bool  prev_sq  = false

if squeezed
    if not prev_sq
        acc_s   := bar_index
        acc_hi  := high
        acc_lo  := low
        acc_cnt := 1
    else
        acc_hi  := math.max(acc_hi, high)
        acc_lo  := math.min(acc_lo, low)
        acc_cnt += 1
    in_acc := acc_cnt >= acc_minbars
else
    acc_hi  := na
    acc_lo  := na
    acc_cnt := 0
    in_acc  := false

prev_sq := squeezed

// ─── Accumulation box ────────────────────────────────────────────────────────
var box   acc_box  = na
var float zone_hi  = na
var float zone_lo  = na
var int   zone_bar = na

if in_acc[1] and not in_acc
    if not na(acc_box)
        box.set_right(acc_box, bar_index - 1)
    acc_box  := na
    zone_hi  := acc_hi[1]
    zone_lo  := acc_lo[1]
    zone_bar := bar_index

if in_acc
    if na(acc_box)
        acc_box := box.new(acc_s, acc_hi, bar_index, acc_lo,
                           border_color=C_ACC_BRD, bgcolor=C_ACC_BG,
                           border_width=1, border_style=line.style_dashed,
                           text="ACCUMULATION", text_color=color.new(#F9A825, 20),
                           text_size=size.tiny, text_halign=text.align_left)
    else
        box.set_left  (acc_box, acc_s)
        box.set_right (acc_box, bar_index)
        box.set_top   (acc_box, acc_hi)
        box.set_bottom(acc_box, acc_lo)

if not na(zone_hi) and not na(zone_bar) and bar_index - zone_bar >= zone_exp_adj
    zone_hi  := na
    zone_lo  := na
    zone_bar := na

have_zone = not na(zone_hi)

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE 2 — MANIPULATION
// ─────────────────────────────────────────────────────────────────────────────
bull_sweep = have_zone and low  < zone_lo - atr * sw_atr and close > zone_lo
bear_sweep = have_zone and high > zone_hi + atr * sw_atr and close < zone_hi

if bull_sweep or bear_sweep
    zone_hi  := na
    zone_lo  := na
    zone_bar := na

var int manip_dir = 0
var int manip_bar = na

if bull_sweep
    manip_dir := 1
    manip_bar := bar_index
    line.new(bar_index - 2, low, bar_index + line_ext_adj, low,
             color=C_MANIP, style=line.style_dashed, width=1)
    label.new(bar_index, low - atr * 0.8, "MANIPULATION\nSweep Below ↓",
              color=color.new(C_MANIP, 0), textcolor=color.white,
              style=label.style_label_up, size=size.small)

if bear_sweep
    manip_dir := -1
    manip_bar := bar_index
    line.new(bar_index - 2, high, bar_index + line_ext_adj, high,
             color=C_MANIP, style=line.style_dashed, width=1)
    label.new(bar_index, high + atr * 0.8, "MANIPULATION\nSweep Above ↑",
              color=color.new(C_MANIP, 0), textcolor=color.white,
              style=label.style_label_down, size=size.small)

barcolor(bull_sweep or bear_sweep ? color.new(C_MANIP, 15) : na, title="Manipulation Bar")

recent_manip = not na(manip_bar) and bar_index - manip_bar <= manip_exp_adj

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE 3 — FVG & IFVG
//
//  A Fair Value Gap is any 3-candle pattern where candle 1 and candle 3 leave
//  a price gap that candle 2 never touched:
//    Bull FVG :  high[2] < low[0]   →  gap from high[2] to low[0]  (up-move)
//    Bear FVG :  low[2]  > high[0]  →  gap from high[0] to low[2]  (down-move)
//
//  When price re-enters the gap → "Inverse FVG" — the zone flips and acts as
//  support (bull IFVG) or resistance (bear IFVG).
//  An IFVG after a manipulation sweep = Distribution entry.
// ─────────────────────────────────────────────────────────────────────────────
bull_fvg = high[2] < low[0]
bear_fvg = low[2]  > high[0]

var FVG[] fvgs = array.new<FVG>()

// Register FVGs — always, or only post-manipulation based on user setting
want_bull_fvg = bull_fvg and (fvg_show_all or recent_manip)
want_bear_fvg = bear_fvg and (fvg_show_all or recent_manip)

// Prune oldest entry if at the cap before adding a new one
if want_bull_fvg or want_bear_fvg
    while array.size(fvgs) >= fvg_max_show
        oldest = array.shift(fvgs)   // remove from front (oldest)
        box.delete(oldest.bx)

if want_bull_fvg
    b = box.new(bar_index - 2, low[0], bar_index + fvg_extend_adj, high[2],
                border_color=color.new(C_BULL_BRD, 0), bgcolor=C_BULL_FVG,
                border_width=1,
                text="FVG", text_color=color.new(#26A69A, 0),
                text_size=size.tiny, text_halign=text.align_right)
    array.push(fvgs, FVG.new(low[0], high[2], 1, bar_index, false, false, b))

if want_bear_fvg
    b = box.new(bar_index - 2, low[2], bar_index + fvg_extend_adj, high[0],
                border_color=color.new(C_BEAR_BRD, 0), bgcolor=C_BEAR_FVG,
                border_width=1,
                text="FVG", text_color=color.new(#EF5350, 0),
                text_size=size.tiny, text_halign=text.align_right)
    array.push(fvgs, FVG.new(low[2], high[0], -1, bar_index, false, false, b))

// ─── Process FVG array ────────────────────────────────────────────────────────
var bool long_signal  = false
var bool short_signal = false
long_signal  := false
short_signal := false

if array.size(fvgs) > 0
    int i = array.size(fvgs) - 1
    while i >= 0
        f = array.get(fvgs, i)

        // Age out
        if bar_index - f.born > fvg_age_adj
            box.delete(f.bx)
            array.remove(fvgs, i)
            i -= 1
            continue

        // First touch → IFVG activation
        if not f.filled and high >= f.bot and low <= f.top
            f.filled := true

            // Restyle: FVG → IFVG (brighter fill, thicker border, updated label)
            if f.dir == 1
                box.set_bgcolor     (f.bx, C_BULL_IFVG)
                box.set_border_color(f.bx, C_BULL_BRD)
                box.set_text        (f.bx, "IFVG")
                box.set_text_color  (f.bx, color.new(#00C853, 0))
            else
                box.set_bgcolor     (f.bx, C_BEAR_IFVG)
                box.set_border_color(f.bx, C_BEAR_BRD)
                box.set_text        (f.bx, "IFVG")
                box.set_text_color  (f.bx, color.new(#FF1744, 0))
            box.set_border_width(f.bx, 2)

            // ── Distribution entry signal ─────────────────────────────────
            if recent_manip and not f.acted
                // Bear gap fills from below → acts as support → LONG after bull sweep
                if f.dir == -1 and manip_dir == 1 and close > f.bot
                    long_signal := true
                    f.acted     := true
                // Bull gap fills from above → acts as resistance → SHORT after bear sweep
                if f.dir == 1 and manip_dir == -1 and close < f.top
                    short_signal := true
                    f.acted      := true

        // Extend unfilled boxes; pin filled boxes in place
        if not f.filled
            box.set_right(f.bx, bar_index + fvg_extend_adj)
        else
            box.set_right(f.bx, f.born + fvg_extend_adj + 10)

        i -= 1

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE 4 — DISTRIBUTION SIGNALS
// ─────────────────────────────────────────────────────────────────────────────
if show_sig
    if long_signal
        sl = close - atr * sl_mult
        tp = close + atr * tp_mult
        label.new(bar_index, low - atr * 1.8, "▲  LONG",
                  color=color.new(C_LONG, 0), textcolor=color.white,
                  style=label.style_label_up, size=size.large)
        line.new(bar_index, tp, bar_index + line_ext_adj, tp,
                 color=color.new(C_LONG, 20), style=line.style_dashed, width=2)
        line.new(bar_index, sl, bar_index + line_ext_adj, sl,
                 color=color.new(C_SHORT, 20), style=line.style_dashed, width=2)
        label.new(bar_index + line_ext_adj, tp, "TP  " + str.tostring(tp, format.mintick),
                  color=color.new(C_LONG, 10), textcolor=color.white,
                  style=label.style_label_left, size=size.tiny)
        label.new(bar_index + line_ext_adj, sl, "SL  " + str.tostring(sl, format.mintick),
                  color=color.new(C_SHORT, 10), textcolor=color.white,
                  style=label.style_label_left, size=size.tiny)

    if short_signal
        sl = close + atr * sl_mult
        tp = close - atr * tp_mult
        label.new(bar_index, high + atr * 1.8, "▼  SHORT",
                  color=color.new(C_SHORT, 0), textcolor=color.white,
                  style=label.style_label_down, size=size.large)
        line.new(bar_index, tp, bar_index + line_ext_adj, tp,
                 color=color.new(C_LONG, 20), style=line.style_dashed, width=2)
        line.new(bar_index, sl, bar_index + line_ext_adj, sl,
                 color=color.new(C_SHORT, 20), style=line.style_dashed, width=2)
        label.new(bar_index + line_ext_adj, tp, "TP  " + str.tostring(tp, format.mintick),
                  color=color.new(C_LONG, 10), textcolor=color.white,
                  style=label.style_label_left, size=size.tiny)
        label.new(bar_index + line_ext_adj, sl, "SL  " + str.tostring(sl, format.mintick),
                  color=color.new(C_SHORT, 10), textcolor=color.white,
                  style=label.style_label_left, size=size.tiny)

plotshape(long_signal  and show_sig, "Long",  shape.triangleup,   location.belowbar, C_LONG,  size=size.normal)
plotshape(short_signal and show_sig, "Short", shape.triangledown, location.abovebar, C_SHORT, size=size.normal)

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE BADGE
// ─────────────────────────────────────────────────────────────────────────────
var label phase_lbl = na
label.delete(phase_lbl)

string p_txt = "SCANNING  " + str.tostring(math.round(atr_fast / atr_slow * 100) / 100)
color  p_col = color.new(color.gray, 20)

if in_acc
    p_txt := "● ACCUMULATION"
    p_col := color.new(#F9A825, 10)
else if bull_sweep
    p_txt := "⚡ MANIPULATION ↓"
    p_col := color.new(C_MANIP, 10)
else if bear_sweep
    p_txt := "⚡ MANIPULATION ↑"
    p_col := color.new(C_MANIP, 10)
else if recent_manip and manip_dir == 1
    p_txt := "▲ DISTRIBUTION"
    p_col := color.new(C_LONG, 10)
else if recent_manip and manip_dir == -1
    p_txt := "▼ DISTRIBUTION"
    p_col := color.new(C_SHORT, 10)
else if have_zone
    p_txt := "◎ WATCHING ZONE"
    p_col := color.new(#F9A825, 30)

phase_lbl := label.new(bar_index + 2, high + atr * 2.2, p_txt,
                        color=p_col, textcolor=color.white,
                        style=label.style_label_left, size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(long_signal,  "AMID — Long",          "AMID: LONG — IFVG + Bull Manipulation")
alertcondition(short_signal, "AMID — Short",         "AMID: SHORT — IFVG + Bear Manipulation")
alertcondition(bull_sweep,   "AMID — Bull Sweep",    "AMID: Bullish liquidity sweep detected")
alertcondition(bear_sweep,   "AMID — Bear Sweep",    "AMID: Bearish liquidity sweep detected")
alertcondition(in_acc,       "AMID — Accumulation",  "AMID: Accumulation zone forming")
