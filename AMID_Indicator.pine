// This Pine Script® code is subject to the Mozilla Public License 2.0
// © AMID — Accumulation · Manipulation · IFVG · Distribution  (v4 — ATR Compression)
//@version=6
indicator("AMID — Accumulation · Manipulation · IFVG · Distribution",
          shorttitle="AMID", overlay=true,
          max_boxes_count=100, max_lines_count=100, max_labels_count=100)

// ─────────────────────────────────────────────────────────────────────────────
//  SETTINGS
// ─────────────────────────────────────────────────────────────────────────────
var G1 = "Accumulation"
acc_ratio   = input.float(0.75, "ATR Compression Ratio", minval=0.3, maxval=0.99, step=0.05, group=G1,
              tooltip="Accumulation fires when ATR(7) < ATR(50) × ratio. Raise toward 0.95 if you never see yellow boxes.")
acc_minbars = input.int  (5,    "Min Bars in Zone",      minval=2,   group=G1)

var G2 = "Manipulation"
sw_atr       = input.float(0.3, "Sweep Distance (× ATR)", minval=0.1, step=0.1, group=G2,
              tooltip="Wick must pierce beyond zone edge by ATR × this.")
manip_expiry = input.int  (60,  "Manipulation Window (bars)", minval=5,  group=G2)
zone_expiry  = input.int  (50,  "Zone Auto-Expiry (bars)",    minval=5,  group=G2,
              tooltip="Zone clears automatically if no sweep is detected within this many bars.")

var G3 = "IFVG"
fvg_min_atr = input.float(0.15, "Min Gap (× ATR)",  minval=0.05, step=0.05, group=G3)
fvg_width   = input.int  (10,   "Box Width (bars)", minval=3,    group=G3)
fvg_max_age = input.int  (60,   "Max Age (bars)",   minval=10,   group=G3)

var G4 = "Signals"
show_sig = input.bool (true, "Show Entry Labels", group=G4)
tp_mult  = input.float(2.5,  "TP (× ATR)",        minval=0.5, step=0.5, group=G4)
sl_mult  = input.float(1.0,  "SL (× ATR)",        minval=0.1, step=0.1, group=G4)

// ─────────────────────────────────────────────────────────────────────────────
//  PALETTE
// ─────────────────────────────────────────────────────────────────────────────
C_ACC_BG   = color.new(#FFFDE7, 55)
C_ACC_BRD  = color.new(#FFC107,  0)
C_MANIP    = #FF6D00
C_BULL_FVG = color.new(#00C853, 65)
C_BEAR_FVG = color.new(#FF1744, 70)
C_BULL_BRD = color.new(#00C853, 20)
C_BEAR_BRD = color.new(#FF1744, 20)
C_LONG     = #00C853
C_SHORT    = #FF1744

// ─────────────────────────────────────────────────────────────────────────────
//  UDT
// ─────────────────────────────────────────────────────────────────────────────
type FVG
    float top
    float bot
    int   dir
    int   born
    bool  filled
    bool  acted
    box   bx

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE 1 — ACCUMULATION  (ATR compression)
//
//  Detects consolidation by comparing short-term to long-term ATR.
//  When recent volatility shrinks to < ratio × baseline volatility the market
//  is coiling — this works on any asset and timeframe with no per-asset tuning.
// ─────────────────────────────────────────────────────────────────────────────
atr      = ta.atr(14)
atr_fast = ta.atr(7)
atr_slow = ta.atr(50)

squeezed = atr_fast < atr_slow * acc_ratio   // volatility compression trigger

var float acc_hi    = na
var float acc_lo    = na
var int   cons_cnt  = 0
var bool  in_acc    = false
var int   acc_s     = 0
var bool  prev_sq   = false

if squeezed
    if not prev_sq
        // First bar of new compression — start zone fresh
        acc_s    := bar_index
        acc_hi   := high
        acc_lo   := low
        cons_cnt := 1
    else
        acc_hi   := math.max(acc_hi, high)
        acc_lo   := math.min(acc_lo, low)
        cons_cnt += 1
    in_acc := cons_cnt >= acc_minbars
else
    acc_hi   := na
    acc_lo   := na
    cons_cnt := 0
    in_acc   := false

prev_sq := squeezed

// ─── Accumulation box ────────────────────────────────────────────────────────
var box   acc_box  = na
var float zone_hi  = na
var float zone_lo  = na
var int   zone_bar = na

if in_acc[1] and not in_acc
    // Zone just ended — freeze box, save zone for sweep detection
    if not na(acc_box)
        box.set_right(acc_box, bar_index - 1)
    acc_box  := na
    zone_hi  := acc_hi[1]
    zone_lo  := acc_lo[1]
    zone_bar := bar_index

if in_acc
    if na(acc_box)
        acc_box := box.new(acc_s, acc_hi, bar_index, acc_lo,
                           border_color=C_ACC_BRD, bgcolor=C_ACC_BG,
                           border_width=1, border_style=line.style_dashed)
    else
        box.set_left  (acc_box, acc_s)
        box.set_right (acc_box, bar_index)
        box.set_top   (acc_box, acc_hi)
        box.set_bottom(acc_box, acc_lo)

// Auto-expire zone if no sweep within zone_expiry bars
if not na(zone_hi) and not na(zone_bar) and bar_index - zone_bar >= zone_expiry
    zone_hi  := na
    zone_lo  := na
    zone_bar := na

have_zone = not na(zone_hi)

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE 2 — MANIPULATION
//
//  Candle wicks beyond zone edge by ≥ sw_atr × ATR then closes back inside.
// ─────────────────────────────────────────────────────────────────────────────
bull_sweep = have_zone and low  < zone_lo - atr * sw_atr and close > zone_lo
bear_sweep = have_zone and high > zone_hi + atr * sw_atr and close < zone_hi

if bull_sweep or bear_sweep
    zone_hi  := na
    zone_lo  := na
    zone_bar := na

var int manip_dir = 0
var int manip_bar = na

if bull_sweep
    manip_dir := 1
    manip_bar := bar_index
    line.new(bar_index - 3, low, bar_index + 30, low,
             color=C_MANIP, style=line.style_dashed, width=1)
    label.new(bar_index, low - atr * 0.9, "MANIPULATION\nSweep Below ↓",
              color=color.new(C_MANIP, 0), textcolor=color.white,
              style=label.style_label_up, size=size.small)

if bear_sweep
    manip_dir := -1
    manip_bar := bar_index
    line.new(bar_index - 3, high, bar_index + 30, high,
             color=C_MANIP, style=line.style_dashed, width=1)
    label.new(bar_index, high + atr * 0.9, "MANIPULATION\nSweep Above ↑",
              color=color.new(C_MANIP, 0), textcolor=color.white,
              style=label.style_label_down, size=size.small)

barcolor(bull_sweep or bear_sweep ? color.new(C_MANIP, 20) : na, title="Manipulation Bar")

recent_manip = not na(manip_bar) and bar_index - manip_bar <= manip_expiry

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE 3 — IFVG  (Inverse Fair Value Gap)
//
//  Only registered within the manipulation window → no chart-wide clutter.
// ─────────────────────────────────────────────────────────────────────────────
bull_fvg = high[2] < low[0]  and (low[0]  - high[2]) >= atr * fvg_min_atr
bear_fvg = low[2]  > high[0] and (low[2]  - high[0]) >= atr * fvg_min_atr

var FVG[] fvgs = array.new<FVG>()

if bull_fvg and recent_manip
    b = box.new(bar_index - 2, low[0], bar_index + fvg_width, high[2],
                border_color=C_BULL_BRD, bgcolor=C_BULL_FVG, border_width=1)
    array.push(fvgs, FVG.new(low[0], high[2], 1, bar_index, false, false, b))

if bear_fvg and recent_manip
    b = box.new(bar_index - 2, low[2], bar_index + fvg_width, high[0],
                border_color=C_BEAR_BRD, bgcolor=C_BEAR_FVG, border_width=1)
    array.push(fvgs, FVG.new(low[2], high[0], -1, bar_index, false, false, b))

var bool long_signal  = false
var bool short_signal = false
long_signal  := false
short_signal := false

if array.size(fvgs) > 0
    int i = array.size(fvgs) - 1
    while i >= 0
        f = array.get(fvgs, i)

        if bar_index - f.born > fvg_max_age
            box.delete(f.bx)
            array.remove(fvgs, i)
            i -= 1
            continue

        if not f.filled and high >= f.bot and low <= f.top
            f.filled := true
            box.set_bgcolor     (f.bx, f.dir == 1 ? color.new(#00C853, 40) : color.new(#FF1744, 45))
            box.set_border_width(f.bx, 2)
            box.set_text        (f.bx, "IFVG")
            box.set_text_color  (f.bx, color.white)
            box.set_text_size   (f.bx, size.tiny)
            box.set_right       (f.bx, f.born + fvg_width + 5)

            if recent_manip and not f.acted
                // Bearish FVG filled after bull sweep → long (inverted to support)
                if f.dir == -1 and manip_dir == 1 and close > f.bot
                    long_signal := true
                    f.acted     := true
                // Bullish FVG filled after bear sweep → short (inverted to resistance)
                if f.dir == 1 and manip_dir == -1 and close < f.top
                    short_signal := true
                    f.acted      := true

        if not f.filled
            box.set_right(f.bx, bar_index + fvg_width)

        i -= 1

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE 4 — DISTRIBUTION  (entry labels + TP / SL lines)
// ─────────────────────────────────────────────────────────────────────────────
if show_sig
    if long_signal
        sl = close - atr * sl_mult
        tp = close + atr * tp_mult
        label.new(bar_index, low - atr * 1.6, "▲  LONG",
                  color=color.new(C_LONG, 0), textcolor=color.white,
                  style=label.style_label_up, size=size.large)
        line.new(bar_index, tp, bar_index + 30, tp,
                 color=color.new(C_LONG, 25), style=line.style_dashed, width=2)
        line.new(bar_index, sl, bar_index + 30, sl,
                 color=color.new(C_SHORT, 25), style=line.style_dashed, width=2)
        label.new(bar_index + 30, tp, "TP", color=color.new(C_LONG,  10), textcolor=color.white, style=label.style_label_left, size=size.tiny)
        label.new(bar_index + 30, sl, "SL", color=color.new(C_SHORT, 10), textcolor=color.white, style=label.style_label_left, size=size.tiny)

    if short_signal
        sl = close + atr * sl_mult
        tp = close - atr * tp_mult
        label.new(bar_index, high + atr * 1.6, "▼  SHORT",
                  color=color.new(C_SHORT, 0), textcolor=color.white,
                  style=label.style_label_down, size=size.large)
        line.new(bar_index, tp, bar_index + 30, tp,
                 color=color.new(C_LONG, 25), style=line.style_dashed, width=2)
        line.new(bar_index, sl, bar_index + 30, sl,
                 color=color.new(C_SHORT, 25), style=line.style_dashed, width=2)
        label.new(bar_index + 30, tp, "TP", color=color.new(C_LONG,  10), textcolor=color.white, style=label.style_label_left, size=size.tiny)
        label.new(bar_index + 30, sl, "SL", color=color.new(C_SHORT, 10), textcolor=color.white, style=label.style_label_left, size=size.tiny)

plotshape(long_signal  and show_sig, "Long",  shape.triangleup,   location.belowbar, C_LONG,  size=size.normal)
plotshape(short_signal and show_sig, "Short", shape.triangledown, location.abovebar, C_SHORT, size=size.normal)

// ─────────────────────────────────────────────────────────────────────────────
//  PHASE BADGE + DEBUG INFO
// ─────────────────────────────────────────────────────────────────────────────
var label phase_lbl = na
label.delete(phase_lbl)

string p_txt = "SCANNING"
color  p_col = color.gray
if in_acc
    p_txt := "ACCUMULATION"
    p_col := #FFC107
else if bull_sweep
    p_txt := "MANIPULATION ↓"
    p_col := C_MANIP
else if bear_sweep
    p_txt := "MANIPULATION ↑"
    p_col := C_MANIP
else if recent_manip and manip_dir == 1
    p_txt := "DISTRIBUTION ↑"
    p_col := C_LONG
else if recent_manip and manip_dir == -1
    p_txt := "DISTRIBUTION ↓"
    p_col := C_SHORT
else if have_zone
    p_txt := "WATCHING ZONE"
    p_col := #FFC107

// Show compression ratio alongside phase so you can tune the threshold
ratio_str = str.tostring(math.round(atr_fast / atr_slow * 100) / 100)
phase_lbl := label.new(bar_index + 2, high + atr * 2,
                        p_txt + "  (" + ratio_str + "/" + str.tostring(acc_ratio) + ")",
                        color=color.new(p_col, 10), textcolor=color.white,
                        style=label.style_label_left, size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(long_signal,  "AMID — Long",       "AMID: LONG signal fired")
alertcondition(short_signal, "AMID — Short",      "AMID: SHORT signal fired")
alertcondition(bull_sweep,   "AMID — Bull Sweep", "AMID: Bullish manipulation sweep")
alertcondition(bear_sweep,   "AMID — Bear Sweep", "AMID: Bearish manipulation sweep")
